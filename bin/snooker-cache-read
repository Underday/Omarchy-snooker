#!/usr/bin/env python3
"""Safely emit a small regular cache file without following links."""

import argparse
import errno
import os
import stat
import sys
import time

MAX_BYTES = 256 * 1024


def main() -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--max-age", type=int, default=-1)
    parser.add_argument("path")
    args = parser.parse_args()

    flags = os.O_RDONLY | os.O_NONBLOCK
    flags |= getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(args.path, flags)
    except OSError as error:
        if error.errno not in (errno.ENOENT, errno.ELOOP, errno.ENXIO):
            print(f"cache open failed: {error}", file=sys.stderr)
        return 1

    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size <= 0 or info.st_size > MAX_BYTES:
            return 1
        if args.max_age >= 0 and time.time() - info.st_mtime >= args.max_age:
            return 1
        if args.check:
            return 0

        remaining = MAX_BYTES + 1
        while remaining:
            chunk = os.read(fd, min(65536, remaining))
            if not chunk:
                return 0
            remaining -= len(chunk)
            if remaining == 0:
                return 1
            view = memoryview(chunk)
            while view:
                written = os.write(sys.stdout.fileno(), view)
                view = view[written:]
        return 1
    except (BrokenPipeError, OSError):
        return 1
    finally:
        os.close(fd)


if __name__ == "__main__":
    raise SystemExit(main())
