#!/usr/bin/env python3
"""Hold the cache directory open and only ever work relative to that descriptor.

Resolving the cache by pathname a second time invites a parent swap between the
check and the use, so the directory is opened once, verified as an owner-private
directory, and every later read or publish goes through that descriptor.
"""

import argparse
import errno
import os
import stat
import sys

MAX_BYTES = 4 * 1024 * 1024
DIR_MODE = 0o700


def open_dir(path, create=False):
    """A no-follow descriptor for an owner-private directory, made if asked."""
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
    flags |= getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags)
    except OSError as error:
        if not create or error.errno not in (errno.ENOENT, errno.ELOOP, errno.ENOTDIR):
            raise
        try:
            os.makedirs(path, mode=DIR_MODE, exist_ok=False)
        except FileExistsError:
            # Something is already there that would not open as a directory.
            raise OSError(errno.ENOTDIR, "not a usable directory", path) from None
        fd = os.open(path, flags)

    try:
        info = os.fstat(fd)
        if not stat.S_ISDIR(info.st_mode):
            raise OSError(errno.ENOTDIR, "not a directory", path)
        if info.st_uid != os.getuid():
            raise OSError(errno.EPERM, "not owned by this user", path)
        if info.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
            # Tighten rather than refuse: an older release left this at 0755.
            os.fchmod(fd, DIR_MODE)
    except OSError:
        os.close(fd)
        raise
    return fd


def read_file(dir_fd, name, limit=MAX_BYTES):
    """Bounded contents of a regular file inside `dir_fd`, or b"" if unusable."""
    flags = os.O_RDONLY | os.O_NONBLOCK
    flags |= getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(name, flags, dir_fd=dir_fd)
    except OSError:
        return b""

    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size <= 0 or info.st_size > limit:
            return b""
        chunks = []
        remaining = limit
        while remaining:
            chunk = os.read(fd, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        return b"".join(chunks)
    except OSError:
        return b""
    finally:
        os.close(fd)


def install(dir_fd, source, name, limit=MAX_BYTES):
    """Publish `source` as `name` inside `dir_fd`, atomically and size-capped."""
    with open(source, "rb") as handle:
        payload = handle.read(limit + 1)
    if not payload or len(payload) > limit:
        return 1

    temp = f".{name}.new"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0)
    fd = os.open(temp, flags, 0o600, dir_fd=dir_fd)
    try:
        view = memoryview(payload)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
    finally:
        os.close(fd)

    try:
        os.replace(temp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except OSError:
        os.unlink(temp, dir_fd=dir_fd)
        raise
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--install", nargs=2, metavar=("SOURCE", "NAME"))
    parser.add_argument("path")
    args = parser.parse_args()

    try:
        dir_fd = open_dir(args.path, create=True)
    except OSError as error:
        print(f"unusable cache directory: {error}", file=sys.stderr)
        return 1

    try:
        if args.install:
            return install(dir_fd, args.install[0], args.install[1])
        return 0
    except OSError as error:
        print(f"cache write failed: {error}", file=sys.stderr)
        return 1
    finally:
        os.close(dir_fd)


if __name__ == "__main__":
    raise SystemExit(main())
